# ==========================================
# WarrantChain — Environment Configuration
# Copy this file to `.env` and fill in your values
# ==========================================

# 1. Reown AppKit (WalletConnect) Project ID
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id_here

# 2. Botchain Testnet Deployer Private Key (used by `npm run deploy:botchain`)
PRIVATE_KEY=

# 3. Deployed ProductWarrantyRegistry Contract Address on Botchain Testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=0x618fd1d309b185aB449E528cD8cCb8E7E1ea90CC

# 4. Botchain Testnet Network Configuration (Chain ID 968)
NEXT_PUBLIC_BOTCHAIN_CHAIN_ID=968
NEXT_PUBLIC_BOTCHAIN_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOTCHAIN_EXPLORER_URL=https://scan.bohr.life/
NEXT_PUBLIC_BOTCHAIN_TOKEN_SYMBOL=BOT
